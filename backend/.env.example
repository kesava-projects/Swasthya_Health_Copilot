# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional: Set to true if deploying backend + frontend together as a single Render Web Service
SERVE_FRONTEND=false

# Database Configuration
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/swasthya_copilot
# Render production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/swasthya_copilot?retryWrites=true&w=majority
# NOTE: In MongoDB Atlas -> Network Access, add IP Address 0.0.0.0/0 to allow connections from Render.

# Authentication
# In Render, this can be automatically generated via Blueprint (render.yaml)
JWT_SECRET=super-secret-key-change-in-production-min-32-chars-long
JWT_EXPIRES_IN=7d

# OCR Microservice URL
# Local: http://127.0.0.1:8000
# Render: http://swasthya-copilot-ocr:8000 (internal) or https://swasthya-copilot-ocr.onrender.com (external)
# If left empty, Swasthya Copilot gracefully falls back to Gemini Multimodal direct analysis!
OCR_SERVICE_URL=http://127.0.0.1:8000

# Private Upload Storage Directory (Legacy backup; all active files stored in MongoDB GridFS)
UPLOAD_DIR=./uploads

# AI Provider Configuration
# Supported providers: gemini, openrouter, mock
AI_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2048

# OpenRouter Configuration (Optional fallback)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-flash-1.5
