{
  "name": "swasthya-copilot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Swasthya Copilot — AI-powered personal health-record management application",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test:backend": "npm --prefix backend test",
    "test:ocr": "PYTHONPATH=ocr-service ./ocr-service/venv/bin/pytest ocr-service/tests/test_ocr.py",
    "evaluate:ocr": "PYTHONPATH=ocr-service ./ocr-service/venv/bin/python ocr-service/evaluation/evaluate_ocr.py"
  }
}
